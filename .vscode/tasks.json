{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Debug x64",
      "type": "shell",
      "command": "& \"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe\" \"${workspaceFolder}\\Heat Haze.sln\" /p:Configuration=Debug /p:Platform=x64 /m",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Build Release x64",
      "type": "shell",
      "command": "& \"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe\" \"${workspaceFolder}\\Heat Haze.sln\" /p:Configuration=Release /p:Platform=x64 /m",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run Debug",
      "type": "shell",
      "command": "& \"${workspaceFolder}\\x64\\Debug\\Heat Haze.exe\"",
      "options": {
        "cwd": "${workspaceFolder}\\Heat Haze",
        "env": {
          "PATH": "C:\\Program Files\\opencv\\build\\x64\\vc16\\bin;${env:PATH}"
        }
      },
      "dependsOn": "Build Debug x64",
      "problemMatcher": []
    }
  ]
}
